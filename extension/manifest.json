{
  "manifest_version": 3,
  "name": "HTML a Figma — Prueba local",
  "version": "0.3.2",
  "description": "Copia la página a capas de Figma o descarga una captura PNG del área visible a 2×.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copiar a Figma",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
